//@version=6
indicator(title='Range | Blocks | NYOpens | Weekendicator | CME | BPR', shorttitle="Abbas1", overlay=true, precision=4, max_bars_back=1000, max_lines_count=500)

// ════════════════════════════════════════════════════════════════════════════
// BOLLINGER BANDS
// ════════════════════════════════════════════════════════════════════════════
length = input.int(21, minval=1, group="BB")
src = input(close, title="Source", group="BB")
mult = input.float(2.8, minval=0.5, maxval=3, step=0.01, group="BB")
basis = ta.sma(src, length)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
plot(basis, "BB Basis", color=color.new(#ff9800, 60))
p1a = plot(upper, "BB Upper", color=color.new(#089981, 60))
p1b = plot(lower, "BB Lower", color=color.new(#f23645, 60))

// ════════════════════════════════════════════════════════════════════════════
// WEEKENDICATOR
// ════════════════════════════════════════════════════════════════════════════
multiplier = input.float(3, minval=0, maxval=10, step=0.1, group="Weekend")

// Optimize: Calculate multiplier once and check weekend condition once
mult_factor = multiplier / 100
is_weekend = dayofweek < 2 or dayofweek > 6
day_clr = is_weekend ? color.new(#9598a1, 80) : color.new(#9598a1, 100)
hl_ratio = high / low
weekendicator_base = ohlc4 * hl_ratio
plot(weekendicator_base * (1 + mult_factor), "Weekendicator Above", style=plot.style_line, color=day_clr)
plot((ohlc4 / hl_ratio) * (1 - mult_factor), "Weekendicator Below", style=plot.style_area, color=day_clr)

// ════════════════════════════════════════════════════════════════════════════
// RANGE BLOCKS
// ════════════════════════════════════════════════════════════════════════════
// Input Settings
msb_sv = input.bool(true, title='Plot MSB lines', group="Range Blocks")
box_sv = input.bool(true, title='Plot Orderblocks', group="Range Blocks")
m_sv = input.bool(true, title='Plot Breakerblocks', group="Range Blocks")
range_sv = input.bool(true, title='Plot Range', group="Range Blocks")
range_eq_sv = input.bool(true, title='Plot Range 0.5 Line', group="Range Blocks")
range_q_sv = input.bool(true, title='Plot Range 0.25 and 0.75 Lines', group="Range Blocks")
u_s = input.color(color.new(#089981, 80), title='Untested Supply Color', group="Range Blocks")
t_s = input.color(color.new(#b2b5be, 80), title='Tested Supply Color', group="Range Blocks")
u_d = input.color(color.new(#f23645, 80), title='Untested Demand Color', group="Range Blocks")
t_d = input.color(color.new(#b2b5be, 80), title='Tested Demand Color', group="Range Blocks")
u_b = input.color(color.new(#ff9800, 80), title='Untested Breaker Color', group="Range Blocks")
t_b = input.color(color.new(#b2b5be, 80), title='Tested Breaker Color', group="Range Blocks")

// Arrays for pivot tracking
var float[] pvh1_price = array.new_float(30, na)  // high
var int[] pvh1_time = array.new_int(30, na)
var float[] pvl1_price = array.new_float(30, na)  // low
var int[] pvl1_time = array.new_int(30, na)
var float[] pvh2_price = array.new_float(10, na)  // higher high
var int[] pvh2_time = array.new_int(10, na)
var float[] pvl2_price = array.new_float(10, na)  // lower low
var int[] pvl2_time = array.new_int(10, na)

// Recent extremes
var float htcmrll_price = na  // high that created most recent ll
var int htcmrll_time = na
var float ltcmrhh_price = na  // low that created most recent hh
var int ltcmrhh_time = na

// Drawing arrays
var box[] long_boxes = array.new_box()      // orderblocks
var box[] short_boxes = array.new_box()
var box[] m_long_boxes = array.new_box()    // breakerblocks
var box[] m_short_boxes = array.new_box()
var line[] bull_bos_lines = array.new_line() // MSB lines
var line[] bear_bos_lines = array.new_line()
var line[] range_h_lines = array.new_line()  // Range lines
var line[] range_25_lines = array.new_line()
var line[] range_m_lines = array.new_line()
var line[] range_75_lines = array.new_line()
var line[] range_l_lines = array.new_line()

// Working variables
var float last_range_h = na
var float last_range_l = na
float temp_pv_0 = na
float temp_pv_1 = na
float temp_pv_2 = na
int temp_time = na
line range_m = na
line range_25 = na
line range_75 = na
float box_top = na
float box_bottom = na

// Pivot detection - optimized
pvh = high < high[1] and high[1] > high[2]
pvl = low > low[1] and low[1] < low[2]
pv1_time = bar_index[1]
pv1_high = high[1]
pv1_low = low[1]
new_ph_2nd = false
new_pl_2nd = false

// Cache array access for current pivot values
float pvh1_0 = na
float pvl1_0 = na
float pvh2_0 = na
float pvl2_0 = na

if barstate.isconfirmed
	// Update cached values at bar confirmation
	pvh1_0 := array.get(pvh1_price, 0)
	pvl1_0 := array.get(pvl1_price, 0)
	pvh2_0 := array.get(pvh2_price, 0)
	pvl2_0 := array.get(pvl2_price, 0)
	
	if pvh
		array.pop(pvh1_price)
		array.pop(pvh1_time)
		array.unshift(pvh1_price, pv1_high)
		array.unshift(pvh1_time, pv1_time)
		if array.size(pvh1_price) > 2
			temp_pv_0 := array.get(pvh1_price, 0)
			temp_pv_1 := array.get(pvh1_price, 1)
			temp_pv_2 := array.get(pvh1_price, 2)
			if temp_pv_0 < temp_pv_1 and temp_pv_1 > temp_pv_2
				array.pop(pvh2_price)
				array.pop(pvh2_time)
				array.unshift(pvh2_price, temp_pv_1)
				int pvh2_time_1 = array.get(pvh1_time, 1)
				array.unshift(pvh2_time, pvh2_time_1)
				new_ph_2nd := true
				if temp_pv_1 > array.get(pvh2_price, 1)
					int pvl2_size = array.size(pvl2_time)
					for i = 0 to pvl2_size - 1
						temp_ltcmrhh_time = array.get(pvl2_time, i)
						if temp_ltcmrhh_time < array.get(pvh2_time, 0)
							ltcmrhh_price := array.get(pvl2_price, i)
							ltcmrhh_time := temp_ltcmrhh_time
							break
			if temp_pv_0 < ltcmrhh_price
				if msb_sv
					array.push(bear_bos_lines, line.new(x1=ltcmrhh_time, y1=ltcmrhh_price, x2=bar_index, y2=ltcmrhh_price, color=color.fuchsia, width=2))
				box_top := array.get(pvh2_price, 0)
				int pvh2_time_0 = array.get(pvh2_time, 0)
				box_bottom := math.max(low[bar_index - pvh2_time_0], low[bar_index - pvh2_time_0 + 1])
				array.push(short_boxes, box.new(left=pvh2_time_0, top=box_top, right=bar_index, bottom=box_bottom, bgcolor=box_sv ? u_s : na, border_color=na, extend=extend.right))
				ltcmrhh_price := na
	if pvl
		array.pop(pvl1_price)
		array.pop(pvl1_time)
		array.unshift(pvl1_price, pv1_low)
		array.unshift(pvl1_time, pv1_time)
		if array.size(pvl1_price) > 2
			temp_pv_0 := array.get(pvl1_price, 0)
			temp_pv_1 := array.get(pvl1_price, 1)
			temp_pv_2 := array.get(pvl1_price, 2)
			if temp_pv_0 > temp_pv_1 and temp_pv_1 < temp_pv_2
				array.pop(pvl2_price)
				array.pop(pvl2_time)
				array.unshift(pvl2_price, temp_pv_1)
				int pvl2_time_1 = array.get(pvl1_time, 1)
				array.unshift(pvl2_time, pvl2_time_1)
				new_pl_2nd := true
				if temp_pv_1 < array.get(pvl2_price, 1)
					int pvh2_size = array.size(pvh2_time)
					for i = 0 to pvh2_size - 1
						temp_htcmrll_time = array.get(pvh2_time, i)
						if temp_htcmrll_time < array.get(pvl2_time, 0)
							htcmrll_price := array.get(pvh2_price, i)
							htcmrll_time := temp_htcmrll_time
							break
			if temp_pv_0 > htcmrll_price
				if msb_sv
					array.push(bull_bos_lines, line.new(x1=htcmrll_time, y1=htcmrll_price, x2=bar_index, y2=htcmrll_price, color=color.olive, width=2))
				int pvl2_time_0 = array.get(pvl2_time, 0)
				box_top := math.min(high[bar_index - pvl2_time_0], high[bar_index - pvl2_time_0 + 1])
				box_bottom := array.get(pvl2_price, 0)
				array.push(long_boxes, box.new(left=pvl2_time_0, top=box_top, right=bar_index, bottom=box_bottom, bgcolor=box_sv ? u_d : na, border_color=na, extend=extend.right))
				htcmrll_price := na
	// Optimize: Cache array sizes and pivot values
	int short_boxes_size = array.size(short_boxes)
	if short_boxes_size > 0
		float pvh1_val = array.get(pvh1_price, 0)
		float pvl1_val = array.get(pvl1_price, 0)
		for i = short_boxes_size - 1 to 0
			tbox = array.get(short_boxes, i)
			top = box.get_top(tbox)
			bottom = box.get_bottom(tbox)
			if pvh1_val > bottom and box_sv
				box.set_bgcolor(tbox, t_s)
			if pvl1_val > top
				if m_sv
					box.set_bgcolor(tbox, u_b)
					array.push(m_long_boxes, tbox)
				else
					box.delete(tbox)
				array.remove(short_boxes, i)
				if msb_sv
					line.delete(array.get(bear_bos_lines, i))
					array.remove(bear_bos_lines, i)
	int long_boxes_size = array.size(long_boxes)
	if long_boxes_size > 0
		float pvh1_val = array.get(pvh1_price, 0)
		float pvl1_val = array.get(pvl1_price, 0)
		for i = long_boxes_size - 1 to 0
			lbox = array.get(long_boxes, i)
			top = box.get_top(lbox)
			bottom = box.get_bottom(lbox)
			if pvl1_val < top and box_sv
				box.set_bgcolor(lbox, t_d)
			if pvh1_val < bottom
				if m_sv
					box.set_bgcolor(lbox, u_b)
					array.push(m_short_boxes, lbox)
				else
					box.delete(lbox)
				array.remove(long_boxes, i)
				if msb_sv
					line.delete(array.get(bull_bos_lines, i))
					array.remove(bull_bos_lines, i)
	int m_short_boxes_size = array.size(m_short_boxes)
	if m_short_boxes_size > 0
		float pvh1_val = array.get(pvh1_price, 0)
		float pvl1_val = array.get(pvl1_price, 0)
		for i = m_short_boxes_size - 1 to 0
			tbox = array.get(m_short_boxes, i)
			top = box.get_top(tbox)
			bottom = box.get_bottom(tbox)
			if pvh1_val > bottom
				box.set_bgcolor(tbox, t_b)
			if pvl1_val > top
				box.delete(tbox)
				array.remove(m_short_boxes, i)
	
	int m_long_boxes_size = array.size(m_long_boxes)
	if m_long_boxes_size > 0
		float pvh1_val = array.get(pvh1_price, 0)
		float pvl1_val = array.get(pvl1_price, 0)
		for i = m_long_boxes_size - 1 to 0
			lbox = array.get(m_long_boxes, i)
			top = box.get_top(lbox)
			bottom = box.get_bottom(lbox)
			if pvl1_val < top
				box.set_bgcolor(lbox, t_b)
			if pvh1_val < bottom
				box.delete(lbox)
				array.remove(m_long_boxes, i)
	// Optimize: Break down complex condition and cache array values
	if range_sv and (new_ph_2nd or new_pl_2nd)
		pvh2_0 := array.get(pvh2_price, 0)
		float pvh2_1 = array.get(pvh2_price, 1)
		pvl2_0 := array.get(pvl2_price, 0)
		float pvl2_1 = array.get(pvl2_price, 1)
		
		bool range_condition = pvh2_0 < pvh2_1 and pvl2_0 > pvl2_1 and pvh2_0 > pvl2_1 and pvl2_0 < pvh2_1
		bool new_range_condition = pvl2_1 > nz(last_range_h) or na(last_range_l) ? true : pvh2_1 < last_range_l
		
		if range_condition and new_range_condition
			temp_time := math.min(array.get(pvh2_time, 1), array.get(pvl2_time, 1))
			last_range_h := pvh2_1
			last_range_l := pvl2_1
			float range_mid = (last_range_h + last_range_l) / 2
			float range_q1 = (last_range_h + range_mid) / 2
			float range_q3 = (last_range_l + range_mid) / 2
			
			array.push(range_h_lines, line.new(x1=temp_time, y1=last_range_h, x2=bar_index, y2=last_range_h, color=color.black, width=2, extend=extend.right))
			array.push(range_l_lines, line.new(x1=temp_time, y1=last_range_l, x2=bar_index, y2=last_range_l, color=color.black, width=2, extend=extend.right))
			if range_eq_sv
				array.push(range_m_lines, line.new(x1=temp_time, y1=range_mid, x2=bar_index, y2=range_mid, color=color.gray, width=2, extend=extend.right))
			if range_q_sv
				array.push(range_25_lines, line.new(x1=temp_time, y1=range_q1, x2=bar_index, y2=range_q1, style=line.style_dashed, color=color.gray, width=1, extend=extend.right))
				array.push(range_75_lines, line.new(x1=temp_time, y1=range_q3, x2=bar_index, y2=range_q3, style=line.style_dashed, color=color.gray, width=1, extend=extend.right))
		
	int range_h_lines_size = array.size(range_h_lines)
	if range_h_lines_size > 0
		float pvh1_val = array.get(pvh1_price, 0)
		float pvl1_val = array.get(pvl1_price, 0)
		for i = range_h_lines_size - 1 to 0
			range_h = array.get(range_h_lines, i)
			top = line.get_y1(range_h)
			range_l = array.get(range_l_lines, i)
			bottom = line.get_y1(range_l)
			
			if pvh1_val < bottom or pvl1_val > top
				line.delete(range_h)
				array.remove(range_h_lines, i)
				line.delete(range_l)
				array.remove(range_l_lines, i)
				if range_eq_sv
					line.delete(array.get(range_m_lines, i))
					array.remove(range_m_lines, i)
				if range_q_sv
					line.delete(array.get(range_25_lines, i))
					array.remove(range_25_lines, i)
					line.delete(array.get(range_75_lines, i))
					array.remove(range_75_lines, i)
				last_range_h := na
				last_range_l := na

// ════════════════════════════════════════════════════════════════════════════
// NEW YORK OPENS
// ════════════════════════════════════════════════════════════════════════════
// Midnight Open Settings
iMDisplay = input.bool(true, "Display", group="New York Midnight Open")
iMTime = input.session('0000-0005:1234567', "Session (New York time)", group="New York Midnight Open")
iMStyle = input.string("Dashed", "Line Style", options=["Solid", "Dotted", "Dashed"], group="New York Midnight Open")
iMColor = input.color(#58A2B0, "Color", group="New York Midnight Open")
iMHistory = input.bool(false, "History", group="New York Midnight Open")
iMLabel = input.bool(true, "Show Label", group="New York Midnight Open")

// 8:30 Open Settings
i8Display = input.bool(true, "Display", group="New York 8:30 Open")
i8Time = input.session('0830-0835:1234567', "Session (New York time)", group="New York 8:30 Open")
i8Style = input.string("Dotted", "Line Style", options=["Solid", "Dotted", "Dashed"], group="New York 8:30 Open")
i8Color = input.color(#58A2B0, "Color", group="New York 8:30 Open")
i8History = input.bool(false, "History", group="New York 8:30 Open")
i8Label = input.bool(true, "Show Label", group="New York 8:30 Open")

// Time checks (sessions are New York local time, so DST is handled for any symbol)
tMidnight = time("1", iMTime, "America/New_York")
t830 = time("1", i8Time, "America/New_York")

// Optimize: Simplify style conversion
_MStyle = iMStyle == "Solid" ? line.style_solid : iMStyle == "Dotted" ? line.style_dotted : line.style_dashed
_8Style = i8Style == "Solid" ? line.style_solid : i8Style == "Dotted" ? line.style_dotted : line.style_dashed

// Midnight Open Logic
if iMDisplay
	var float openMidnight = 0.0
	var label lb = na
	var line lne = na
	
	if not na(tMidnight)
		openMidnight := not na(tMidnight[1]) ? math.max(open, openMidnight) : open
	
	if openMidnight != openMidnight[1] and barstate.isconfirmed
		line.set_x2(lne, tMidnight)
		int line_end = last_bar_time + 7200000  // Optimize: Simplified time calculation
		lne := line.new(tMidnight, openMidnight, line_end, openMidnight, xloc.bar_time, extend.none, iMColor, _MStyle, 1)
		
		if iMLabel
			lb := label.new(line_end, openMidnight, "Midnight", xloc.bar_time, yloc.price, na, label.style_none, iMColor, size.normal, text.align_right)
		label.delete(lb[1])
		
		if not iMHistory
			line.delete(lne[1])

// 8:30 Open Logic
if i8Display
	var float open830 = 0.0
	var label lb2 = na
	var line lne2 = na
	
	if not na(t830)
		open830 := not na(t830[1]) ? math.max(open, open830) : open
	
	if open830 != open830[1] and barstate.isconfirmed
		line.set_x2(lne2, t830 - 30600000)
		int line_end = last_bar_time + 7200000  // Optimize: Simplified time calculation
		lne2 := line.new(t830, open830, line_end, open830, xloc.bar_time, extend.none, i8Color, _8Style, 1)
		
		if i8Label
			lb2 := label.new(line_end, open830, "8:30", xloc.bar_time, yloc.price, na, label.style_none, i8Color, size.normal, text.align_right)
		label.delete(lb2[1])
		
		if not i8History
			line.delete(lne2[1])

// ════════════════════════════════════════════════════════════════════════════
// BALANCED PRICE RANGE (BPR)
// ════════════════════════════════════════════════════════════════════════════
bpr_threshold = input.float(0, step=0.25, title="BPR Threshold", tooltip="Valid BPR's must have a range greater than this number", group="Balanced Price Range")
bars_since = input(50, "Bars to Look Back for BPR", tooltip="Only look for BPR's when a sequence of bearish and bullish FVG's are within this many bars of each other", group="Balanced Price Range")
only_clean_bpr = input(false, "Only Clean BPR", tooltip="Only show BPR's when price does not interfere with the range prior to its completion", group="Balanced Price Range")
delete_old_bpr = input(true, "Delete Old BPR", tooltip="Delete all BPR's that have been invalidated or overwritten. Only show current/active BPR's", group="Balanced Price Range")
bearish_bpr_color = input.color(color.new(color.green, 70), "Bearish BPR Color", group="Balanced Price Range")
bullish_bpr_color = input.color(color.new(color.green, 70), "Bullish BPR Color", group="Balanced Price Range")

// BPR Variables
var box box_bearish = na
var box box_bullish = na

// FVG Detection (Fair Value Gap)
new_fvg_bearish = low[2] - high > 0
new_fvg_bullish = low - high[2] > 0

// Bullish BPR Logic
bull_num_since = ta.barssince(new_fvg_bearish)
bull_bpr_cond_1 = new_fvg_bullish and bull_num_since <= bars_since
bool bull_bpr_cond_2 = false
float bull_combined_low = na
float bull_combined_high = na

if bull_bpr_cond_1
    // Optimize: Calculate once and reuse
    float sum_prices = high[bull_num_since] + low[bull_num_since + 2] + high[2] + low
    float diff_prices = math.max(low[bull_num_since + 2], low) - math.min(high[bull_num_since], high[2])
    bull_bpr_cond_2 := sum_prices > diff_prices
    
    if bull_bpr_cond_2
        bull_combined_low := math.max(high[bull_num_since], high[2])
        bull_combined_high := math.min(low[bull_num_since + 2], low)

bool bull_bpr_cond_3 = true
if only_clean_bpr and bull_bpr_cond_2
    for h = 2 to bull_num_since
        if high[h] > bull_combined_low
            bull_bpr_cond_3 := false
            break  // Optimize: Exit early

bull_result = bull_bpr_cond_1 and bull_bpr_cond_2 and bull_bpr_cond_3 and (bull_combined_high - bull_combined_low >= bpr_threshold)

if bull_result[1]
    if delete_old_bpr and not na(box_bullish)
        box.delete(box_bullish)
    box_bullish := box.new(bar_index - bull_num_since - 1, bull_combined_high[1], bar_index + 1, bull_combined_low[1], border_color=bullish_bpr_color, border_width=1, bgcolor=bullish_bpr_color)

if not na(box_bullish)
    if low > box.get_bottom(box_bullish)
        box.set_right(box_bullish, bar_index + 1)
    else if low < box.get_bottom(box_bullish)
        if delete_old_bpr
            box.delete(box_bullish)
        box_bullish := na 

// Bearish BPR Logic
bear_num_since = ta.barssince(new_fvg_bullish)
bear_bpr_cond_1 = new_fvg_bearish and bear_num_since <= bars_since
bool bear_bpr_cond_2 = false
float bear_combined_low = na
float bear_combined_high = na

if bear_bpr_cond_1
    // Optimize: Calculate once and reuse
    float sum_prices = high[bear_num_since] + low[bear_num_since + 2] + high[2] + low
    float diff_prices = math.max(low[bear_num_since + 2], low) - math.min(high[bear_num_since], high[2])
    bear_bpr_cond_2 := sum_prices > diff_prices
    
    if bear_bpr_cond_2
        bear_combined_low := math.max(high[bear_num_since + 2], high)
        bear_combined_high := math.min(low[bear_num_since], low[2])

bool bear_bpr_cond_3 = true
if only_clean_bpr and bear_bpr_cond_2
    for h = 2 to bear_num_since
        if low[h] < bear_combined_high
            bear_bpr_cond_3 := false
            break  // Optimize: Exit early

bear_result = bear_bpr_cond_1 and bear_bpr_cond_2 and bear_bpr_cond_3 and (bear_combined_high - bear_combined_low >= bpr_threshold)

if bear_result[1]
    if delete_old_bpr and not na(box_bearish)
        box.delete(box_bearish)
    box_bearish := box.new(bar_index - bear_num_since - 1, bear_combined_high[1], bar_index + 1, bear_combined_low[1], border_color=bearish_bpr_color, border_width=1, bgcolor=bearish_bpr_color)

if not na(box_bearish)
    if high < box.get_top(box_bearish)
        box.set_right(box_bearish, bar_index + 1)
    else if high > box.get_top(box_bearish)
        if delete_old_bpr
            box.delete(box_bearish)
        box_bearish := na

// ════════════════════════════════════════════════════════════════════════════
// CME GAP SHOW AND FILL
// ════════════════════════════════════════════════════════════════════════════
mode = input.string(
     defval="1 - Close from current symbol",
     title="Mode",
     options=["1 - Close from current symbol", "2 - CME original close price", "3 - CME settlement price"],
     tooltip="In Mode 1 the closing price is determined in the current symbol but with the trading hours from the CME futures contract. Mode 2 and 3 obtain the price directly from the CME futures contract and paint it in the chart of the current symbol. But note, that modes 2 and 3 may not give you the expected result, due to price differences in futures and spot prices.",
     group="CME gap")

// Optimize: Only request security data if needed
cme = mode == "2 - CME original close price" ? request.security("CME:BTC1!", "60", close) : na
cmeSettlement = mode == "3 - CME settlement price" ? request.security("CME:BTC1!", "D", close, lookahead=barmerge.lookahead_on) : na

// Function to get Friday closing price according to CME trading hours
getCloseCME() =>
    var float cmeClose = 0.0
    var int showLine = 0
    
    // Optimize: Pre-calculate timestamp
    bool is_friday_close = dayofweek == 6 and time == timestamp('GMT-5', year, month, dayofmonth, 16, 0, 0)
    bool is_weekend_start = time >= timestamp('GMT-5', year, month, dayofmonth, 16, 0, 0) and dayofweek >= 6
    bool is_monday_open = dayofweek <= 1 and time >= timestamp('GMT-5', year, month, dayofmonth, 17, 0, 0)
    
    if is_friday_close
        cmeClose := mode == "1 - Close from current symbol" ? close[1] : mode == "2 - CME original close price" ? cme : cmeSettlement
    
    showLine := showLine == 0 and is_weekend_start ? 1 : showLine == 1 and is_monday_open ? 0 : showLine
    
    [cmeClose, showLine]

[cmeClose, showLine] = getCloseCME()

// Plotting
plot1 = plot(showLine == 1 ? cmeClose : na, 'CME Friday Close', style=plot.style_linebr, linewidth=2, color=color.new(color.blue, 0))
plot2 = plot(close, 'Dummy plot for background', color=na)
fill(plot1, plot2, title='CME Background', color=close > cmeClose ? color.new(color.green, 80) : close < cmeClose ? color.new(color.red, 80) : na)